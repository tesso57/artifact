{
  "name": "pi-artifacts",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @pi-artifacts/viewer run dev",
    "test": "vitest --run",
    "typecheck": "tsc -p apps/viewer --noEmit && tsc -p packages/extension --noEmit && tsc -p packages/core --noEmit && tsc -p packages/extension/skills/artifacts/templates --noEmit",
    "test:e2e": "node test/e2e/run.ts",
    "knip": "knip",
    "check:templates": "node test/e2e/check-templates.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "knip": "^5.88.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
